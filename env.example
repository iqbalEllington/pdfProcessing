# Copy this file to .env and fill in real values. Never commit the real .env.

# A long random secret used to sign JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# How long issued tokens stay valid, in minutes. Default 120 (2 hours).
JWT_EXPIRE_MINUTES=120

# JSON object mapping username -> bcrypt password hash.
# Generate each hash with: python3 generate_password_hash.py
# Add one entry per client you want to grant access to.
USERS_JSON={"client1": "$2b$12$REPLACE_WITH_REAL_HASH"}
